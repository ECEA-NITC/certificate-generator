{
  "name": "certificate_generator",
  "version": "1.0.0",
  "description": "Local-only Electron desktop app for generating certificates in bulk",
  "homepage": "https://example.org/certificate-generator",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && NODE_ENV=development electron electron/main.js",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "electron-builder",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "type": "module",
  "dependencies": {
    "fabric": "^5.3.0",
    "papaparse": "^5.4.1",
    "xlsx": "^0.18.5",
    "pdf-lib": "^1.17.1",
    "uuid": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.10",
    "wait-on": "^7.2.0",
    "electron": "^28.0.0"
  },
  "build": {
    "appId": "com.certificate.generator",
    "productName": "Certificate Generator",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Certificate Generator <certificates@localhost>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
